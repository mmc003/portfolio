{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm install && npm install --prefix server --include=dev",
  "buildCommand": "node server/scripts/set-provider.js postgresql && cd server && npx prisma generate && npm run build && cd .. && npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "server/dist/**,server/node_modules/.prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
