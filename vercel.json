{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm install && npm install --prefix server",
  "buildCommand": "node server/scripts/set-provider.js postgresql && cd server && npx prisma generate && cd .. && npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "server/src/**,server/prisma/**"
    }
  }
}
