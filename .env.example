# ─────────────────────────────────────────────────────────────
# Portfolio API — environment variables (root-level, shared docs)
# Copy to `.env` (server/) and fill in real values. NEVER commit
# a real `.env`. Only this `.env.example` is committed.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
# Optional override for the media-URL origin. Leave EMPTY for local dev: media
# URLs are then derived from the request host, so they work on any port without
# config. Set this only behind a proxy/CDN where the request host is unreliable.
# PUBLIC_BASE_URL=https://api.example.com

# CORS — the exact origin(s) allowed to call the API.
# Use the frontend origin in production, e.g. https://portfolio.example.com
CORS_ORIGIN=*

# ── Admin ─────────────────────────────────────────────────────
# Secret token required for all /api/admin/* routes.
# REQUIRED in production. In non-production a clearly-insecure
# dev token is used if unset (a loud warning is logged).
# Generate one: openssl rand -hex 32
ADMIN_API_TOKEN=replace-me-with-a-long-random-secret

# ── Database (Prisma) ─────────────────────────────────────────
# Local/test default = SQLite file (zero external services).
# Production = PostgreSQL connection string.
DATABASE_URL="file:./dev.db"
# PostgreSQL examples:
#   Local Postgres:   postgresql://user:password@localhost:5432/portfolio?schema=public
#   Supabase (use the POOLER for serverless/Prisma — port 6543):
#     postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ── Object storage ────────────────────────────────────────────
# Storage driver: "local" (filesystem, default for dev/test) or "s3".
STORAGE_DRIVER=local

# Local filesystem adapter settings
STORAGE_LOCAL_DIR=./uploads

# S3-compatible settings (used when STORAGE_DRIVER=s3)
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portfolio-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Public base URL prepended to object keys. If using a CDN, point
# this at the CDN. Leave empty to fall back to S3_ENDPOINT/<bucket>.
S3_PUBLIC_BASE_URL=

# ── Upload limits & image processing ──────────────────────────
# Max upload size in megabytes (largest source photo is ~29 MB).
MAX_UPLOAD_SIZE_MB=50
IMAGE_THUMBNAIL_WIDTH=500
IMAGE_MEDIUM_WIDTH=1600
# Force derivatives to WebP (set false to keep source format).
IMAGE_DERIVATIVE_FORMAT=webp
