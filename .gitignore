# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
# Never commit real environment files (only .env.example is tracked).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large portfolio media — migrated to object storage (server-side), no longer
# tracked in Git. Files are kept locally for reference but excluded from the
# repository and the production bundle. (Small UI assets — fonts in src/Navbar,
# public/ icons — remain tracked.)
/src/imgs/
/src/homepage/

# Local backend dev artifacts (also covered by server/.gitignore)
/server/dev.db
/server/dev.db-journal
/server/uploads/
